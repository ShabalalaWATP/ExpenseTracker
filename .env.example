# Non-secret model configuration. These defaults are also built into the app.
OPENAI_RECEIPT_MODEL=gpt-5.6-sol
OPENAI_POLICY_MODEL=gpt-5.6-sol
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_VOICE=marin

# Set these only in Sites runtime secrets or an ignored local .dev.vars file.
EXPENSETRACKER_OWNER_EMAIL=
OPENAI_API_KEY=
